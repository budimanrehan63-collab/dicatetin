# ==========================================
# DICATETIN ENVIRONMENT VARIABLES CONFIGURATION
# ==========================================

# Supabase (Database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App URL & Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Superadmin Seed Configuration
SUPERADMIN_EMAIL=admin@dicatetin.id
SUPERADMIN_PASSWORD=Superadmin123!

# Security & Encryption (AES-256 Secret Key for AI Provider Keys)
ENCRYPTION_SECRET_KEY=dicatetin-secret-encryption-key-32-chars-min!

# AI Providers (Default / Fallback)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=DicatetinBot
TELEGRAM_WEBHOOK_SECRET=your-custom-webhook-secret-token

# Midtrans Payment Gateway
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
MIDTRANS_IS_PRODUCTION=false

# Resend (Email Service)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Dicatetin <notifikasi@dicatetin.id>"

# Cron Security Secret (for /api/cron/*)
CRON_SECRET=dicatetin_cron_secret_token_12345
